# TaskQueue Storage Configuration
# Storage mode: file_only, bullmq_only, dual_write, read_bullmq_write_both
TASKQUEUE_STORAGE_MODE=file_only

# File storage path (defaults to OS-specific app data directory)
# TASK_MANAGER_FILE_PATH=/path/to/tasks.json

# Redis connection settings (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# LLM Provider API Keys
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Google AI Configuration
GOOGLE_API_KEY=your_google_api_key

# DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key

# Logging Configuration
# Set DEBUG=ioredis:* to enable Redis debug logs
# DEBUG=ioredis:*
