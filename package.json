{
	"name": "taskqueue-mcp",
	"version": "1.4.1",
	"description": "Task Queue MCP Server",
	"author": "Christopher C. Smith (christopher.smith@promptlytechnologies.com)",
	"main": "dist/src/server/index.js",
	"type": "module",
	"bin": {
		"taskqueue-mcp": "dist/src/server/index.js",
		"taskqueue": "dist/src/client/index.js"
	},
	"files": [
		"dist/src/**/*.js",
		"dist/src/**/*.d.ts",
		"dist/src/**/*.js.map"
	],
	"scripts": {
		"build": "tsc && shx cp src/server/redisLoader.cjs dist/src/server/",
		"start": "node dist/src/server/index.js",
		"dev": "tsc && shx cp src/server/redisLoader.cjs dist/src/server/ && node dist/src/server/index.js",
		"test": "tsc && shx cp src/server/redisLoader.cjs dist/src/server/ && NODE_OPTIONS=--experimental-vm-modules MODE=test npx jest",
		"cli": "node dist/src/cli.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chriscarrollsmith/taskqueue-mcp.git"
	},
	"keywords": [
		"taskqueue",
		"taskqueue-mcp",
		"taskqueue",
		"mcp",
		"claude"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@ai-sdk/deepseek": "^0.2.4",
		"@ai-sdk/google": "^1.2.18",
		"@ai-sdk/openai": "^1.3.6",
		"@ai-sdk/xai": "^1.2.16",
		"@blaxel/core": "^0.2.2",
		"@blaxel/vercel": "^0.2.2",
		"@bull-board/api": "^6.9.5",
		"@bull-board/express": "^6.9.5",
		"@modelcontextprotocol/sdk": "^1.11.1",
		"@types/express": "^5.0.1",
		"@wizdy/ai": "latest",
		"@wizdy/typescript-sdk": "^1.0.7",
		"bullmq": "^5.1.1",
		"chalk": "^5.4.1",
		"cli-table3": "^0.6.5",
		"commander": "^13.1.0",
		"dotenv": "^16.4.7",
		"express": "^5.1.0",
		"glob": "^11.0.1",
		"ioredis": "^5.3.2",
		"zod": "^3.24.2",
		"zod-to-json-schema": "^3.24.5"
	},
